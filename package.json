{
  "name": "leafer-ui",
  "version": "2.2.11",
  "description": "Next-Generation AI Infinite Canvas & Graphic Agent Engine built on Leafer UI",
  "author": "Chao (Leafer) Wan & Leafer AI Team",
  "license": "MIT",
  "type": "module",
  "main": "dist/web.esm.min.js",
  "exports": {
    ".": {
      "import": "./dist/web.esm.min.js",
      "require": "./dist/web.min.cjs",
      "types": "./types/index.d.ts"
    },
    "./ai": {
      "import": "./packages/ai/src/index.ts",
      "types": "./packages/ai/src/index.ts"
    },
    "./agent": {
      "import": "./packages/agent/src/index.ts",
      "types": "./packages/agent/src/index.ts"
    },
    "./edit-toolbar": {
      "import": "./packages/edit-toolbar/src/index.ts",
      "types": "./packages/edit-toolbar/src/index.ts"
    }
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "echo 'Build Leafer packages'"
  },
  "types": "types/index.d.ts",
  "unpkg": "dist/web.min.js",
  "jsdelivr": "dist/web.min.js",
  "files": [
    "src",
    "types",
    "dist",
    "packages",
    "README.md",
    "README-EN.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leaferjs/leafer-ui"
  },
  "homepage": "https://github.com/leaferjs/leafer-ui",
  "bugs": "https://github.com/leaferjs/leafer-ui/issues",
  "keywords": [
    "leaferui",
    "leafer-ui",
    "leaferjs",
    "leafer",
    "html5",
    "canvas",
    "2d",
    "ai-canvas",
    "agent",
    "infinite-canvas",
    "graphic",
    "renderer",
    "engine"
  ],
  "dependencies": {
    "@leafer/core": "2.2.11",
    "@leafer/partner": "2.2.11",
    "@leafer/interface": "2.2.11",
    "@leafer-ui/draw": "2.2.11",
    "@leafer-ui/core": "2.2.11",
    "@leafer-ui/web": "2.2.11",
    "@leafer-ui/interaction-web": "2.2.11",
    "@leafer-ui/partner": "2.2.11",
    "@leafer-ui/interface": "2.2.11",
    "@leafer-in/interface": "2.2.11"
  }
}
